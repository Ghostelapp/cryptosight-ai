{
  "name": "cryptosight-ai",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w apps/web",
    "start": "node scripts/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "gateway": "node --env-file-if-exists=.env services/gateway/index.mjs",
    "worker": "node --env-file-if-exists=.env services/worker/index.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "secrets:generate": "node scripts/secrets.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "admin:bootstrap": "node scripts/admin-bootstrap.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "ws": "^8.22.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}

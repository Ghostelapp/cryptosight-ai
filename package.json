{
  "name": "cryptosight-ai",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w apps/web",
    "start": "node scripts/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "gateway": "node --env-file-if-exists=.env services/gateway/index.mjs",
    "worker": "node --env-file-if-exists=.env services/worker/index.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "secrets:generate": "node scripts/secrets.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "admin:bootstrap": "node scripts/admin-bootstrap.mjs",
    "mobile:start": "npm run start -w apps/mobile",
    "mobile:android": "npm run android -w apps/mobile",
    "mobile:apk": "node scripts/mobile-apk.mjs",
    "mobile:ios": "npm run ios -w apps/mobile",
    "mobile:check": "npm run typecheck -w apps/mobile",
    "mobile:export": "npm run export -w apps/mobile",
    "mobile:lint": "npm run lint -w apps/mobile"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "ws": "^8.22.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}

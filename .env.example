# Development. Copy to .env, generate keys with npm run secrets:generate.
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Development can use an embedded PostgreSQL engine; production requires DATABASE_URL.
# DATABASE_URL=postgresql://cryptosight:password@localhost:5432/cryptosight
POSTGRES_PASSWORD=replace-with-random-hex-admin-password
APP_DB_PASSWORD=replace-with-random-hex-runtime-password
# REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-random-32-byte-secret
BYOK_KEY_ID=primary
BYOK_ENCRYPTION_KEY=replace-with-base64-32-byte-key
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:3001
GATEWAY_PORT=3001
WORKER_PORT=3002
FREE_DAILY_LIMIT=10
PRO_DAILY_LIMIT=100
FREE_DAILY_BUDGET_USD=5
PRO_DAILY_BUDGET_USD=20
ANALYSIS_RESERVATION_USD=0.5
# Per-million token prices, supplied by operator and verified against provider billing.
MODEL_PRICING_JSON={}
# Optional integrations. Empty means unavailable; no fabricated data.
SMTP_URL=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEWS_RSS_URL=
CALENDAR_API_URL=
CALENDAR_API_KEY=
TELEGRAM_BOT_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
LOCAL_LLM_URL=
LOCAL_LLM_ALLOWED_HOSTS=localhost,127.0.0.1,ollama
LOCAL_LLM_KEY=
SENTRY_DSN=
ONCHAIN_API_URL=
ONCHAIN_API_KEY=
SENTIMENT_API_URL=
SENTIMENT_API_KEY=
LIQUIDATIONS_API_URL=
LIQUIDATIONS_API_KEY=

# Allowed EVM network IDs for signed wallet authentication. No RPC or transaction access.
WALLET_CHAIN_IDS=1,8453,137,42161,10,43114,56,84532,11155111

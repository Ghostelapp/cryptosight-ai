# Install as /etc/nginx/sites-available/cryptosight-app after obtaining its certificate.
server {
    listen 80;
    listen [::]:80;
    server_name app.cryptosight.tech;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://app.cryptosight.tech$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name app.cryptosight.tech;
    client_max_body_size 4m;
    ssl_certificate /etc/letsencrypt/live/app.cryptosight.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.cryptosight.tech/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    include /opt/cryptosight/deploy/nginx.conf;
}
